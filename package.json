    "check": "npm run typecheck && npm run test && npm run build",
    "package:plugin": "node scripts/package-plugin.mjs",
    "verify:plugin": "node scripts/verify-plugin-package.mjs",
    "bridge": "node bridge/index.mjs",
    "bridge:client": "node scripts/bridge-client.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "tar": "7.5.22",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "4.4.3"
